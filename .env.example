# Vaultwarden Deployment Configuration
# Copy this to .env and fill in your secrets. NEVER commit .env to Git.
#
# To generate the ADMIN_TOKEN:
#   echo -n "YourMasterPassword" | argon2 "$(openssl rand -base64 32)" -e -id -k 65540 -t 3 -p 4
#
# Security:
# - Set a STRONG ADMIN_TOKEN (argon2-hashed recommended for admin panel)
# - Keep SIGNUPS_ALLOWED=false after creating initial users
# - Require MFA for all organization members

# Domain where Vaultwarden will be accessible
VW_DOMAIN=vaultwarden.lockeinvestments.net

# Argon2-hashed admin token (generate with argon2 CLI)
# Leave empty to disable admin panel
VW_ADMIN_TOKEN=

# User registration
VW_SIGNUPS_ALLOWED=false
VW_SIGNUPS_VERIFY=false
VW_SIGNUPS_DOMAINS_WHITELIST=lockeinvestments.net

# Allow existing users to invite new users
VW_INVITATIONS_ALLOWED=true

# Security hardening
VW_SHOW_PASSWORD_HINT=false
VW_WEBSOCKET_ENABLED=true
